# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# The core app (Postgres + this Next.js server) will run with just the
# DATABASE_URL / NEXT_PUBLIC_APP_URL section below filled in. Everything
# past that points at external services (IAM/auth server, FHIR server,
# AI agents, LiveKit, Vapi, FileNest, ...) that live in separate repos —
# features depending on them will error or no-op until those services are
# reachable at the configured URLs.

# ── Database ─────────────────────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml / docker-compose.dev.yml
DATABASE_URL="postgresql://drgodly:drgodly@localhost:5432/drgodly?schema=public"

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:4000

# ── BetterAuth (external IAM service — separate repo) ───────────────────────
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:5001
BETTER_AUTH_URL=http://localhost:5001
NEXT_PUBLIC_BETTER_AUTH_CLIENT_ID=your_better_auth_client_id
BETTER_AUTH_CLIENT_SECRET=your_better_auth_client_secret

# ── FHIR server (external — separate repo) ──────────────────────────────────
FHIR_SERVER_URL=http://localhost:8001
NEXT_PUBLIC_FHIR_SERVER_URL=http://localhost:8001
FHIR_GQL_URL=http://localhost:8005/api/v1

# GraphQL endpoint (mounted at server root, not under /api/v1). Used only by
# the ai-hub create_patient workflow pilot — see src/app/api/workflow/_lib.ts.
FHIR_GRAPHQL_URL=http://localhost:8005/graphql

# restapi or graphql transport for the FHIR client (default restapi)
FHIR_TRANSPORT=rest

# ── ABDM (Ayushman Bharat Digital Mission) ──────────────────────────────────
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret

# ── Vapi (voice AI) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPI_API_KEY=your_vapi_api_key
NEXT_PUBLIC_VAPI_AGENT_ID=your_vapi_agent_id

# ── LiveKit (video/voice consultations) ─────────────────────────────────────
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_AGENT_URL=http://localhost:8000

# ── LLM providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key
THESYS_API_KEY=your_thesys_api_key
NEXT_PUBLIC_COPILOT_CLOUD_PUBLIC_API_KEY=your_copilot_cloud_public_api_key

# ── AI agents (external Python microservices — see agents/ for local dev) ──
INTAKE_AGENT_URL=http://localhost:8018/api/agent/intake
CONSULTATION_AGENT_URL=http://localhost:8018/api/agent/consult
ASSESSMENT_PLAN_AGENT_URL=http://localhost:8018/api/agent/assessment
DOCTOR_REPORT_AGENT_URL=http://localhost:8018/api/agent/consultation-workflow
TEXT_TO_SQL_AGENT_URL=http://localhost:8018/api/agent/mcpagent
DOCTOR_ASSISTANT_AGENT_URL=http://localhost:8018/api/agent/doctoragent
AGENT_CLINICAL_API_URL=http://localhost:8018/api/agent/clinical-extraction

INTAKE_VOICE_AGENT_URL=http://localhost:8018
CONSULTATION_VOICE_AGENT_URL=http://localhost:8018
INPERSON_CONSULTATION_AGENT_URL=http://localhost:8018

# A2UI workflow agent
AGENT_API_URL=http://localhost:8015/api/agent/workflow

# ── FileNest (document/report storage) ──────────────────────────────────────
FILENEST_API_KEY=your_filenest_api_key
FILENEST_PROJECT_ID=your_filenest_project_id
FILENEST_API_URL=http://localhost:8000
FILENEST_WEBHOOK_SECRET=your_filenest_webhook_secret

NEXT_PUBLIC_FILENEST_PROJECT_ID=your_filenest_project_id
NEXT_PUBLIC_FILENEST_API_URL=http://localhost:8000

# ── Redis (provisioned via docker-compose.yml, not yet consumed by the app) ─
# REDIS_URL=redis://localhost:6379
