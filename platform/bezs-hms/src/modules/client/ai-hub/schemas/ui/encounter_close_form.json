{
  "id": "encounter-close-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "encounter-close-form",
      "type": "Form",
      "properties": {
        "action": { "name": "close_encounter" },
        "submitLabel": { "literalString": "Close Encounter" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "close-form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Close Encounter" },
              "usageHint": "h2"
            }
          },
          {
            "id": "close-form-info",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Encounter $encounter_id will be closed." },
              "usageHint": "caption"
            }
          },
          { "id": "close-divider-top", "type": "Divider", "properties": {} },
          {
            "id": "close-section-status",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Final Status" },
              "usageHint": "h4"
            }
          },
          {
            "id": "status",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Final Status" },
              "placeholder": { "literalString": "Select final status…" },
              "items": "$status_concepts.concepts",
              "valueType": { "literalString": "code" }
            }
          },
          { "id": "close-divider-timing", "type": "Divider", "properties": {} },
          {
            "id": "close-section-timing",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Encounter End Time" },
              "usageHint": "h4"
            }
          },
          {
            "id": "actual_period_end",
            "type": "DateTimeInput",
            "properties": {
              "label": { "literalString": "Encounter End" },
              "enableDate": true,
              "enableTime": true
            }
          }
        ]
      }
    }
  }
}
