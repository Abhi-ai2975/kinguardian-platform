{
  "id": "practitioner-comm-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "practitioner-comm-form",
      "type": "Form",
      "properties": {
        "action": { "name": "add_practitioner_communication" },
        "submitLabel": { "literalString": "Save Languages" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": { "text": { "literalString": "Step 6: Add Communication Languages" }, "usageHint": "h2" }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": { "text": { "literalString": "Record languages this practitioner uses with patients." }, "usageHint": "caption" }
          },
          { "id": "divider-top", "type": "Divider", "properties": {} },
          {
            "id": "communications",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add Language" },
              "minItems": { "literalNumber": 1 },
              "defaultCount": { "literalNumber": 1 },
              "template": [
                {
                  "id": "language",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Language" },
                    "placeholder": { "literalString": "Search language…" },
                    "items": "$communication_language_concepts.concepts",
                    "valueType": { "literalString": "CodeableConcept" }
                  }
                },
                {
                  "id": "preferred",
                  "type": "CheckBox",
                  "properties": { "label": { "literalString": "Preferred Language" }, "value": { "literalBoolean": false } }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
