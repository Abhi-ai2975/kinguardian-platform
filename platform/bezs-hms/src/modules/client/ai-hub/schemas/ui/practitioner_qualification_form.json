{
  "id": "practitioner-qual-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "practitioner-qual-form",
      "type": "Form",
      "properties": {
        "action": { "name": "add_practitioner_qualification" },
        "submitLabel": { "literalString": "Save Qualifications" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": { "text": { "literalString": "Step 5: Add Qualifications" }, "usageHint": "h2" }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": { "text": { "literalString": "Add medical degrees, licences, and professional certifications." }, "usageHint": "caption" }
          },
          { "id": "divider-top", "type": "Divider", "properties": {} },
          {
            "id": "qualifications",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add Qualification" },
              "minItems": { "literalNumber": 1 },
              "defaultCount": { "literalNumber": 1 },
              "template": [
                {
                  "id": "code_text",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Qualification" },
                    "placeholder": { "literalString": "e.g. MD - Doctor of Medicine" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "prac-qual-code-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "code_code",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Code (optional)" },
                          "placeholder": { "literalString": "e.g. 394814009" },
                          "textFieldType": "shortText"
                        }
                      },
                      {
                        "id": "code_system",
                        "type": "TextField",
                        "weight": 2,
                        "properties": {
                          "label": { "literalString": "Code System (optional)" },
                          "placeholder": { "literalString": "e.g. http://snomed.info/sct" },
                          "textFieldType": "shortText"
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "prac-qual-period-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "period_start",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Valid From (optional)" },
                          "placeholder": { "literalString": "YYYY-MM-DD" },
                          "textFieldType": "date"
                        }
                      },
                      {
                        "id": "period_end",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Expires (optional)" },
                          "placeholder": { "literalString": "YYYY-MM-DD" },
                          "textFieldType": "date"
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "prac-qual-issuer-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "issuer",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Issuer Reference (optional)" },
                          "placeholder": { "literalString": "e.g. Organization/100" },
                          "textFieldType": "shortText"
                        }
                      },
                      {
                        "id": "issuer_display",
                        "type": "TextField",
                        "weight": 2,
                        "properties": {
                          "label": { "literalString": "Issuer Name (optional)" },
                          "placeholder": { "literalString": "e.g. General Medical Council" },
                          "textFieldType": "shortText"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
