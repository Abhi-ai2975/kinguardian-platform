{
  "id": "add-observations-root",
  "type": "Column",
  "properties": {
    "gap": "small",
    "children": [
      {
        "id": "ao-back-form",
        "type": "Form",
        "properties": {
          "action": { "name": "back_to_choose" },
          "submitLabel": { "literalString": "← Change selection" },
          "gap": "small",
          "alignment": "start",
          "children": []
        }
      },
      {
        "id": "ao-main-card",
        "type": "Card",
        "properties": {
          "child": {
            "id": "add-observations-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_observations_batch" },
        "submitLabel": { "literalString": "Save Observations →" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "ao-form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Step 4: Add Observations" },
              "usageHint": "h2"
            }
          },
          {
            "id": "ao-form-subtitle",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "Add one or more clinical observations or measurements for this encounter. Status is required for each item."
              },
              "usageHint": "caption"
            }
          },
          { "id": "ao-divider-existing", "type": "Divider", "properties": {} },
          {
            "id": "ao-existing-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Existing Observations" },
              "usageHint": "h4"
            }
          },
          {
            "id": "ao-existing-count-row",
            "type": "Row",
            "properties": {
              "gap": "small",
              "alignment": "center",
              "children": [
                {
                  "id": "ao-existing-num",
                  "type": "Text",
                  "properties": { "text": "$existing_observations.total", "usageHint": "h3" }
                },
                {
                  "id": "ao-existing-suffix",
                  "type": "Text",
                  "properties": {
                    "text": { "literalString": "observation(s) already recorded for this encounter" },
                    "usageHint": "caption"
                  }
                }
              ]
            }
          },
          { "id": "ao-divider-new", "type": "Divider", "properties": {} },
          {
            "id": "ao-new-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "New Observations" },
              "usageHint": "h4"
            }
          },
          {
            "id": "observations_group",
            "type": "RepeatableGroup",
            "properties": {
              "label": { "literalString": "Observations to Add" },
              "addLabel": { "literalString": "Add Another Observation" },
              "defaultCount": 1,
              "minItems": 1,
              "maxItems": 10,
              "allowDuplicate": false,
              "template": [
                {
                  "id": "code",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "LOINC Code" },
                    "placeholder": { "literalString": "Search LOINC codes…" },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "system": "http://loinc.org",
                      "minChars": 2,
                      "debounceMs": 200
                    }
                  }
                },
                {
                  "id": "obs-status-cat-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "status",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Status *" },
                          "placeholder": { "literalString": "Select status…" },
                          "items": "$status_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      },
                      {
                        "id": "category",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Category" },
                          "placeholder": { "literalString": "Select category…" },
                          "items": "$category_concepts.concepts",
                          "valueType": { "literalString": "CodeableConcept" }
                        }
                      },
                      {
                        "id": "interpretation",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Interpretation" },
                          "placeholder": { "literalString": "Select interpretation…" },
                          "items": "$interpretation_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "obs-value-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "value_quantity",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Value (number)" },
                          "placeholder": { "literalString": "e.g. 98.6" },
                          "textFieldType": "text"
                        }
                      },
                      {
                        "id": "value_quantity_unit",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Unit" },
                          "placeholder": { "literalString": "e.g. °F, mmHg, mg/dL" },
                          "textFieldType": "text"
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "value_string",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Value (text, optional)" },
                    "placeholder": { "literalString": "Free-text observation value" },
                    "textFieldType": "text"
                  }
                },
                {
                  "id": "obs-timing-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "effective_datetime",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Effective Date/Time" },
                          "enableDate": true,
                          "enableTime": true
                        }
                      },
                      {
                        "id": "issued",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Issued" },
                          "enableDate": true,
                          "enableTime": true
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "note",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Note (optional)" },
                    "placeholder": { "literalString": "Additional notes" },
                    "textFieldType": "longText"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
    ]
  }
}
