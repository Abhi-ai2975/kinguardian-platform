{
  "id": "practitioner-telecom-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "practitioner-telecom-form",
      "type": "Form",
      "properties": {
        "action": { "name": "add_practitioner_telecom" },
        "submitLabel": { "literalString": "Save Contact Points" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": { "text": { "literalString": "Step 4: Add Contact Points" }, "usageHint": "h2" }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": { "text": { "literalString": "Add phone, email, or other contact details for this practitioner." }, "usageHint": "caption" }
          },
          { "id": "divider-top", "type": "Divider", "properties": {} },
          {
            "id": "telecom",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add Contact" },
              "minItems": { "literalNumber": 1 },
              "defaultCount": { "literalNumber": 1 },
              "template": [
                {
                  "id": "prac-telecom-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "system",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Type" },
                          "placeholder": { "literalString": "e.g. phone…" },
                          "items": "$telecom_system_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      },
                      {
                        "id": "value",
                        "type": "TextField",
                        "weight": 2,
                        "properties": {
                          "label": { "literalString": "Value" },
                          "placeholder": { "literalString": "e.g. +1-555-0100" },
                          "textFieldType": "shortText"
                        }
                      },
                      {
                        "id": "use",
                        "type": "TerminologySelect",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Use" },
                          "placeholder": { "literalString": "e.g. work…" },
                          "items": "$telecom_use_concepts.concepts",
                          "valueType": { "literalString": "code" }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
