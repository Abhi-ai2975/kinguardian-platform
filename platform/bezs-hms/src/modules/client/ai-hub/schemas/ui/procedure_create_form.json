{
  "id": "procedure-create-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "procedure-create-form",
      "type": "Form",
      "properties": {
        "action": { "name": "record_procedure" },
        "submitLabel": { "literalString": "Record Procedure" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "proc-title",
            "type": "Text",
            "properties": { "text": { "literalString": "Record Procedure" }, "usageHint": "h2" }
          },
          {
            "id": "proc-subtitle",
            "type": "Text",
            "properties": { "text": { "literalString": "Patient and encounter resolved from session." }, "usageHint": "caption" }
          },
          { "id": "proc-divider-top", "type": "Divider", "properties": {} },
          {
            "id": "proc-code-heading",
            "type": "Text",
            "properties": { "text": { "literalString": "Procedure Code" }, "usageHint": "h4" }
          },
          {
            "id": "code",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Procedure Code" },
              "placeholder": { "literalString": "Search SNOMED…" },
              "valueType": { "literalString": "CodeableConcept" },
              "serverSearch": {
                "system": "http://snomed.info/sct",
                "minChars": 2,
                "debounceMs": 200
              }
            }
          },
          {
            "id": "category",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Category (optional)" },
              "placeholder": { "literalString": "Select category…" },
              "items": "$category_concepts.concepts",
              "valueType": { "literalString": "CodeableConcept" }
            }
          },
          { "id": "proc-divider-status", "type": "Divider", "properties": {} },
          {
            "id": "proc-status-heading",
            "type": "Text",
            "properties": { "text": { "literalString": "Status & Outcome" }, "usageHint": "h4" }
          },
          {
            "id": "proc-status-outcome-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "status",
                  "type": "TerminologySelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Status" },
                    "placeholder": { "literalString": "Select status…" },
                    "items": "$status_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                },
                {
                  "id": "outcome",
                  "type": "TerminologySelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Outcome (optional)" },
                    "placeholder": { "literalString": "Select outcome…" },
                    "items": "$outcome_concepts.concepts",
                    "valueType": { "literalString": "CodeableConcept" }
                  }
                }
              ]
            }
          },
          { "id": "proc-divider-performer", "type": "Divider", "properties": {} },
          {
            "id": "proc-performer-heading",
            "type": "Text",
            "properties": { "text": { "literalString": "Performer & Location" }, "usageHint": "h4" }
          },
          {
            "id": "proc-performer-location-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "performer",
                  "type": "DataSelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Performer (optional)" },
                    "placeholder": { "literalString": "Select practitioner…" },
                    "items": "$booking_practitioners.data",
                    "labelPath": "practitioner_detail.name.text",
                    "emits": [
                      { "key": "ref_id", "path": "practitioner_ref_id" }
                    ]
                  }
                },
                {
                  "id": "location",
                  "type": "DataSelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Location (optional)" },
                    "placeholder": { "literalString": "Select location…" },
                    "items": "$my_locations.data",
                    "labelPath": "name",
                    "emits": [
                      { "key": "ref_id", "path": "id" }
                    ]
                  }
                }
              ]
            }
          },
          {
            "id": "performed_datetime",
            "type": "DateTimeInput",
            "properties": {
              "label": { "literalString": "Performed Date/Time (optional)" },
              "enableDate": true,
              "enableTime": true
            }
          },
          {
            "id": "note_text",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Note (optional)" },
              "placeholder": { "literalString": "Add a clinical note…" },
              "textFieldType": "longText"
            }
          }
        ]
      }
    }
  }
}
