{
  "id": "hcs-create-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "hcs-create-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_healthcare_service" },
        "submitLabel": { "literalString": "Create Service" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Create Healthcare Service" },
              "usageHint": "h2"
            }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "Register a clinical service offered by your organisation — including its type, specialty, locations, contact details, and availability."
              },
              "usageHint": "caption"
            }
          },
          { "id": "divider-top", "type": "Divider", "properties": {} },

          {
            "id": "section-photo",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Service Photo" },
              "usageHint": "h4"
            }
          },
          {
            "id": "service_photo",
            "type": "FileUpload",
            "properties": {
              "label": { "literalString": "Representative photo (optional)" },
              "tokenEndpoint": { "literalString": "/api/filenest-token" },
              "filePath": "healthcare-services/photos",
              "allowedMimeTypes": ["image/jpeg", "image/png", "image/webp"],
              "maxFiles": { "literalNumber": 1 },
              "maxSizeMb": { "literalNumber": 5 },
              "autoUpload": false,
              "userId": "$user_id",
              "orgId": "$org_id"
            }
          },
          { "id": "divider-photo", "type": "Divider", "properties": {} },

          {
            "id": "section-core",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Service Details" },
              "usageHint": "h4"
            }
          },
          {
            "id": "hcs-name-active-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "name",
                  "type": "TextField",
                  "weight": 3,
                  "properties": {
                    "label": { "literalString": "Service Name" },
                    "placeholder": {
                      "literalString": "e.g. General Practice Consultation"
                    },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "active",
                  "type": "CheckBox",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Active" },
                    "value": { "literalBoolean": true }
                  }
                }
              ]
            }
          },
          {
            "id": "appointment_required",
            "type": "CheckBox",
            "properties": {
              "label": { "literalString": "Appointment Required" },
              "value": { "literalBoolean": false }
            }
          },
          {
            "id": "comment",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Comment (optional)" },
              "placeholder": {
                "literalString": "Short public-facing description of the service"
              },
              "textFieldType": "longText"
            }
          },
          {
            "id": "extra_details",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Extra Details (optional)" },
              "placeholder": {
                "literalString": "Internal notes or additional information not shown to patients"
              },
              "textFieldType": "longText"
            }
          },

          { "id": "divider-class", "type": "Divider", "properties": {} },
          {
            "id": "section-class",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Classification" },
              "usageHint": "h4"
            }
          },
          {
            "id": "section-class-desc",
            "type": "Text",
            "properties": {
              "text": {
                "literalString": "Classify the service so patients can find it. Add one or more entries per field."
              },
              "usageHint": "caption"
            }
          },

          {
            "id": "section-categories-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Categories" },
              "usageHint": "caption"
            }
          },
          {
            "id": "categories",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add category" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "category",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Category" },
                    "placeholder": { "literalString": "Search categories…" },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "resource": "HealthcareService",
                      "field": "category",
                      "minChars": 0
                    }
                  }
                }
              ]
            }
          },

          {
            "id": "section-service-types-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Service Types" },
              "usageHint": "caption"
            }
          },
          {
            "id": "service_types",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add service type" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "service_type",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Service Type" },
                    "placeholder": { "literalString": "Search service types…" },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "resource": "HealthcareService",
                      "field": "type",
                      "minChars": 0
                    }
                  }
                }
              ]
            }
          },

          {
            "id": "section-specialties-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Specialties" },
              "usageHint": "caption"
            }
          },
          {
            "id": "specialties",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add specialty" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "specialty",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Specialty" },
                    "placeholder": { "literalString": "Search specialties…" },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "resource": "HealthcareService",
                      "field": "specialty",
                      "minChars": 0
                    }
                  }
                }
              ]
            }
          },

          {
            "id": "section-spc-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Service Provision Codes" },
              "usageHint": "caption"
            }
          },
          {
            "id": "service_provision_codes",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add provision code" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "service_provision_code",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Provision Code" },
                    "placeholder": {
                      "literalString": "e.g. free, cost at clinic, discounted…"
                    },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "resource": "HealthcareService",
                      "field": "serviceProvisionCode",
                      "minChars": 0
                    }
                  }
                }
              ]
            }
          },

          { "id": "divider-links", "type": "Divider", "properties": {} },
          {
            "id": "section-links",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Organisation & Locations" },
              "usageHint": "h4"
            }
          },
          {
            "id": "org",
            "type": "DynamicSelect",
            "properties": {
              "label": { "literalString": "Provided By (Organisation)" },
              "placeholder": { "literalString": "Search organisations…" },
              "source": {
                "url": "$fhir_gql_url/organizations/",
                "staticParams": { "org_id": { "path": "org_id" } },
                "searchParam": "name",
                "responsePath": "data",
                "minChars": 0,
                "debounceMs": 300,
                "pageSize": 20,
                "limitParam": "limit",
                "offsetParam": "offset"
              },
              "display": {
                "label": { "path": "name" },
                "description": { "template": "Organization/{id}" }
              },
              "emits": [
                { "key": "org_ref_id", "path": "id" },
                { "key": "org_display", "path": "name" }
              ]
            }
          },
          {
            "id": "section-locations-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Locations" },
              "usageHint": "caption"
            }
          },
          {
            "id": "locations",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add location" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "location_select",
                  "type": "DynamicSelect",
                  "properties": {
                    "label": { "literalString": "Location" },
                    "placeholder": { "literalString": "Search locations…" },
                    "source": {
                      "url": "$fhir_gql_url/locations/",
                      "staticParams": { "org_id": { "path": "org_id" } },
                      "searchParam": "name",
                      "responsePath": "data",
                      "minChars": 0,
                      "debounceMs": 300,
                      "pageSize": 20,
                      "limitParam": "limit",
                      "offsetParam": "offset"
                    },
                    "display": {
                      "label": { "path": "name" },
                      "description": { "template": "Location/{id}" }
                    },
                    "emits": [
                      {
                        "key": "location_reference",
                        "template": "Location/{id}"
                      },
                      { "key": "location_display", "path": "name" }
                    ]
                  }
                }
              ]
            }
          },

          { "id": "divider-contact", "type": "Divider", "properties": {} },
          {
            "id": "section-contact",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Contact Details" },
              "usageHint": "h4"
            }
          },
          {
            "id": "telecoms",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add contact" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "system",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Type" },
                    "placeholder": {
                      "literalString": "e.g. phone, email, fax…"
                    },
                    "valueType": { "literalString": "code" },
                    "serverSearch": {
                      "resource": "Patient",
                      "field": "telecom.system",
                      "minChars": 0
                    }
                  }
                },
                {
                  "id": "value",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Value" },
                    "placeholder": { "literalString": "e.g. +61 3 9000 0000" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "use",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Use (optional)" },
                    "placeholder": {
                      "literalString": "e.g. work, home, mobile…"
                    },
                    "valueType": { "literalString": "code" },
                    "serverSearch": {
                      "resource": "Patient",
                      "field": "telecom.use",
                      "minChars": 0
                    }
                  }
                },
                {
                  "id": "rank",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Rank (optional)" },
                    "placeholder": { "literalString": "1 = highest priority" },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          },

          { "id": "divider-prog", "type": "Divider", "properties": {} },
          {
            "id": "section-prog",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Programs & Languages" },
              "usageHint": "h4"
            }
          },
          {
            "id": "section-programs-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Programs" },
              "usageHint": "caption"
            }
          },
          {
            "id": "programs",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add program" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "program",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Program" },
                    "placeholder": {
                      "literalString": "e.g. NHS, Medicare, NDIS…"
                    },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "resource": "HealthcareService",
                      "field": "program",
                      "minChars": 0
                    }
                  }
                }
              ]
            }
          },
          {
            "id": "section-comms-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Supported Languages" },
              "usageHint": "caption"
            }
          },
          {
            "id": "communications",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add language" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "communication",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Language" },
                    "placeholder": {
                      "literalString": "e.g. English, Mandarin, Arabic…"
                    },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "resource": "HealthcareService",
                      "field": "communication",
                      "minChars": 0
                    }
                  }
                }
              ]
            }
          },

          { "id": "divider-identifiers", "type": "Divider", "properties": {} },
          {
            "id": "section-identifiers",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Identifiers" },
              "usageHint": "h4"
            }
          },
          {
            "id": "identifiers",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add identifier" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "use",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Use (optional)" },
                    "placeholder": {
                      "literalString": "e.g. official, usual, temp…"
                    },
                    "valueType": { "literalString": "code" },
                    "serverSearch": {
                      "resource": "Patient",
                      "field": "identifier.use",
                      "minChars": 0
                    }
                  }
                },
                {
                  "id": "system",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "System URI (optional)" },
                    "placeholder": {
                      "literalString": "e.g. https://my-hospital.org/services"
                    },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "value",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Value" },
                    "placeholder": { "literalString": "Identifier value" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "assigner",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Assigner (optional)" },
                    "placeholder": {
                      "literalString": "Organisation that issued this identifier"
                    },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "identifier-period-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "period_start",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Valid From (optional)" },
                          "enableDate": true,
                          "enableTime": false
                        }
                      },
                      {
                        "id": "period_end",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": {
                            "literalString": "Valid Until (optional)"
                          },
                          "enableDate": true,
                          "enableTime": false
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "type_code",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Type Code (optional)" },
                    "placeholder": {
                      "literalString": "Coding code for identifier type"
                    },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "type_system",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Type System (optional)" },
                    "placeholder": {
                      "literalString": "Coding system URI for identifier type"
                    },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "type_display",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Type Display (optional)" },
                    "placeholder": {
                      "literalString": "Human-readable label for type"
                    },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          },

          { "id": "divider-char", "type": "Divider", "properties": {} },
          {
            "id": "section-char",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Characteristics & Referral" },
              "usageHint": "h4"
            }
          },
          {
            "id": "section-char-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Characteristics" },
              "usageHint": "caption"
            }
          },
          {
            "id": "characteristics",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add characteristic" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "characteristic",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Characteristic" },
                    "placeholder": {
                      "literalString": "e.g. wheelchair accessible, bulk billing…"
                    },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "resource": "HealthcareService",
                      "field": "characteristic",
                      "minChars": 0
                    }
                  }
                }
              ]
            }
          },
          {
            "id": "section-ref-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Referral Methods" },
              "usageHint": "caption"
            }
          },
          {
            "id": "referral_methods",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add referral method" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "referral_method",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Referral Method" },
                    "placeholder": {
                      "literalString": "e.g. phone, fax, online portal…"
                    },
                    "valueType": { "literalString": "CodeableConcept" },
                    "serverSearch": {
                      "resource": "HealthcareService",
                      "field": "referralMethod",
                      "minChars": 0
                    }
                  }
                }
              ]
            }
          },

          { "id": "divider-avail", "type": "Divider", "properties": {} },
          {
            "id": "section-avail",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Availability" },
              "usageHint": "h4"
            }
          },
          {
            "id": "section-avail-hours-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Regular Hours" },
              "usageHint": "caption"
            }
          },
          {
            "id": "available_time",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add hours" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "days-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "mon",
                        "type": "CheckBox",
                        "properties": { "label": { "literalString": "Mon" } }
                      },
                      {
                        "id": "tue",
                        "type": "CheckBox",
                        "properties": { "label": { "literalString": "Tue" } }
                      },
                      {
                        "id": "wed",
                        "type": "CheckBox",
                        "properties": { "label": { "literalString": "Wed" } }
                      },
                      {
                        "id": "thu",
                        "type": "CheckBox",
                        "properties": { "label": { "literalString": "Thu" } }
                      },
                      {
                        "id": "fri",
                        "type": "CheckBox",
                        "properties": { "label": { "literalString": "Fri" } }
                      },
                      {
                        "id": "sat",
                        "type": "CheckBox",
                        "properties": { "label": { "literalString": "Sat" } }
                      },
                      {
                        "id": "sun",
                        "type": "CheckBox",
                        "properties": { "label": { "literalString": "Sun" } }
                      }
                    ]
                  }
                },
                {
                  "id": "all_day",
                  "type": "Switch",
                  "properties": { "label": { "literalString": "All day" } }
                },
                {
                  "id": "avail-times-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "available_start_time",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Opens" },
                          "placeholder": { "literalString": "09:00" },
                          "textFieldType": "shortText"
                        }
                      },
                      {
                        "id": "available_end_time",
                        "type": "TextField",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Closes" },
                          "placeholder": { "literalString": "17:00" },
                          "textFieldType": "shortText"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },

          {
            "id": "section-notavail-label",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Not Available Periods" },
              "usageHint": "caption"
            }
          },
          {
            "id": "not_available",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add period" },
              "defaultCount": 0,
              "minItems": 0,
              "template": [
                {
                  "id": "description",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Reason" },
                    "placeholder": {
                      "literalString": "e.g. Public holiday closure"
                    },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "notavail-dates-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "during_start",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "From" },
                          "enableDate": true,
                          "enableTime": false
                        }
                      },
                      {
                        "id": "during_end",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Until" },
                          "enableDate": true,
                          "enableTime": false
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },

          {
            "id": "availability_exceptions",
            "type": "TextField",
            "properties": {
              "label": {
                "literalString": "Availability Exceptions (optional)"
              },
              "placeholder": {
                "literalString": "Describe any irregular availability rules, e.g. closed last Friday of each month"
              },
              "textFieldType": "longText"
            }
          }
        ]
      }
    }
  }
}
