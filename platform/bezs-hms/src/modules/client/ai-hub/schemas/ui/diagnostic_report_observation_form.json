{
  "id": "diag-obs-create-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "diag-obs-create-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_observation" },
        "submitLabel": { "literalString": "Record Result" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "obs-title",
            "type": "Text",
            "properties": { "text": { "literalString": "Step 2: Add Result Observation" }, "usageHint": "h2" }
          },
          {
            "id": "obs-subtitle",
            "type": "Text",
            "properties": { "text": { "literalString": "Linked to diagnostic report from step 1." }, "usageHint": "caption" }
          },
          { "id": "obs-divider-top", "type": "Divider", "properties": {} },
          {
            "id": "obs-code-heading",
            "type": "Text",
            "properties": { "text": { "literalString": "Result Code" }, "usageHint": "h4" }
          },
          {
            "id": "code",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Result Code (LOINC)" },
              "placeholder": { "literalString": "Search LOINC…" },
              "valueType": { "literalString": "CodeableConcept" },
              "serverSearch": {
                "system": "http://loinc.org",
                "minChars": 2,
                "debounceMs": 200
              }
            }
          },
          {
            "id": "status",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Status" },
              "placeholder": { "literalString": "Select status…" },
              "items": "$status_concepts.concepts",
              "valueType": { "literalString": "code" }
            }
          },
          { "id": "obs-divider-value", "type": "Divider", "properties": {} },
          {
            "id": "obs-value-heading",
            "type": "Text",
            "properties": { "text": { "literalString": "Value" }, "usageHint": "h4" }
          },
          {
            "id": "obs-value-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "value_quantity",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Quantity" },
                    "placeholder": { "literalString": "e.g. 5.2" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "value_quantity_unit",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Unit (optional)" },
                    "placeholder": { "literalString": "e.g. mg/dL" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "value_string",
                  "type": "TextField",
                  "weight": 2,
                  "properties": {
                    "label": { "literalString": "Text Result (optional)" },
                    "placeholder": { "literalString": "e.g. Positive" },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          },
          {
            "id": "obs-range-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "reference_range_low",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Reference Range Low (optional)" },
                    "placeholder": { "literalString": "e.g. 3.5" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "reference_range_high",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Reference Range High (optional)" },
                    "placeholder": { "literalString": "e.g. 5.5" },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          },
          {
            "id": "interpretation",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Interpretation (optional)" },
              "placeholder": { "literalString": "Select interpretation…" },
              "items": "$interpretation_concepts.concepts",
              "valueType": { "literalString": "code" }
            }
          }
        ]
      }
    }
  }
}
