{
  "id": "mr-create-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "mr-create-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_medication_request" },
        "submitLabel": { "literalString": "Place Order" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "mr-form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Prescribe Medication" },
              "usageHint": "h2"
            }
          },
          {
            "id": "mr-form-subtitle",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Select a medication from the formulary or search by RxNorm code. Add dosage and dispensing instructions below." },
              "usageHint": "caption"
            }
          },
          { "id": "mr-divider-top", "type": "Divider", "properties": {} },
          {
            "id": "mr-section-medication",
            "type": "Text",
            "properties": { "text": { "literalString": "Medication" }, "usageHint": "h4" }
          },
          {
            "id": "medication",
            "type": "DataSelect",
            "properties": {
              "label": { "literalString": "Select Medication" },
              "placeholder": { "literalString": "Select from formulary…" },
              "items": "$my_medications.data",
              "labelPath": "display",
              "emits": [
                { "key": "ref_id", "path": "id" },
                { "key": "display", "path": "display" }
              ]
            }
          },
          {
            "id": "medication_code",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Or Search by RxNorm" },
              "placeholder": { "literalString": "Search RxNorm…" },
              "valueType": { "literalString": "CodeableConcept" },
              "serverSearch": {
                "system": "http://www.nlm.nih.gov/research/umls/rxnorm",
                "minChars": 2,
                "debounceMs": 200
              }
            }
          },
          { "id": "mr-divider-order", "type": "Divider", "properties": {} },
          {
            "id": "mr-section-order",
            "type": "Text",
            "properties": { "text": { "literalString": "Order" }, "usageHint": "h4" }
          },
          {
            "id": "mr-status-intent-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "status",
                  "type": "TerminologySelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Status" },
                    "placeholder": { "literalString": "Select status…" },
                    "items": "$status_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                },
                {
                  "id": "intent",
                  "type": "TerminologySelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Intent" },
                    "placeholder": { "literalString": "Select intent…" },
                    "items": "$intent_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                }
              ]
            }
          },
          { "id": "mr-divider-dosage", "type": "Divider", "properties": {} },
          {
            "id": "mr-section-dosage",
            "type": "Text",
            "properties": { "text": { "literalString": "Dosage" }, "usageHint": "h4" }
          },
          {
            "id": "dosage_text",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Dosage Instructions" },
              "placeholder": { "literalString": "500mg orally every 8 hours for 7 days" },
              "textFieldType": "longText"
            }
          },
          {
            "id": "route",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Route" },
              "placeholder": { "literalString": "Search administration route…" },
              "valueType": { "literalString": "CodeableConcept" },
              "serverSearch": {
                "system": "http://snomed.info/sct",
                "minChars": 2,
                "debounceMs": 200
              }
            }
          },
          { "id": "mr-divider-dispensing", "type": "Divider", "properties": {} },
          {
            "id": "mr-section-dispensing",
            "type": "Text",
            "properties": { "text": { "literalString": "Dispensing" }, "usageHint": "h4" }
          },
          {
            "id": "mr-dispense-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "dispense_quantity",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Quantity" },
                    "placeholder": { "literalString": "e.g. 30" },
                    "textFieldType": "number"
                  }
                },
                {
                  "id": "dispense_unit",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Unit" },
                    "placeholder": { "literalString": "tablet, capsule, mL" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "repeats",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Refills" },
                    "placeholder": { "literalString": "e.g. 2" },
                    "textFieldType": "number"
                  }
                }
              ]
            }
          },
          { "id": "mr-divider-requester", "type": "Divider", "properties": {} },
          {
            "id": "mr-section-requester",
            "type": "Text",
            "properties": { "text": { "literalString": "Requester & Timing" }, "usageHint": "h4" }
          },
          {
            "id": "requester",
            "type": "DataSelect",
            "properties": {
              "label": { "literalString": "Requesting Practitioner (optional)" },
              "placeholder": { "literalString": "Search practitioners…" },
              "items": "$booking_practitioners.data",
              "labelPath": "practitioner_detail.name.text",
              "descriptionPath": "specialty.0.coding_display",
              "emits": [
                { "key": "ref_id", "path": "practitioner_ref_id" }
              ]
            }
          },
          {
            "id": "authored_on",
            "type": "DateTimeInput",
            "properties": {
              "label": { "literalString": "Authored On (optional)" },
              "enableDate": true,
              "enableTime": true
            }
          },
          {
            "id": "mr-session-note",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Patient and encounter resolved from session. Link to condition: condition_id carried from Record Condition." },
              "usageHint": "caption"
            }
          }
        ]
      }
    }
  }
}
