{
  "id": "appointment-confirm-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "appointment-confirm-form",
      "type": "Form",
      "properties": {
        "action": { "name": "create_appointment" },
        "submitLabel": { "literalString": "Book Appointment" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Step 3: Confirm Booking" },
              "usageHint": "h2"
            }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Review the selection below and confirm the booking." },
              "usageHint": "caption"
            }
          },
          {
            "id": "divider-top",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "summary-practitioner",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Practitioner: $practitioner_display" },
              "usageHint": "caption"
            }
          },
          {
            "id": "summary-slot-start",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Slot: $slot_start — $slot_end" },
              "usageHint": "caption"
            }
          },
          {
            "id": "divider-summary",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "status",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Status" },
              "placeholder": { "literalString": "Search status…" },
              "items": "$appointment_status_concepts.concepts",
              "valueType": { "literalString": "code" }
            }
          },
          {
            "id": "appointment_type",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Appointment Type (optional)" },
              "placeholder": { "literalString": "Search appointment type…" },
              "items": "$appointment_type_concepts.concepts",
              "valueType": { "literalString": "CodeableConcept" }
            }
          },
          {
            "id": "description",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Description (optional)" },
              "placeholder": { "literalString": "e.g. Follow-up visit for hypertension management" },
              "textFieldType": "longText"
            }
          }
        ]
      }
    }
  }
}
