{
  "id": "specimen-create-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "specimen-create-form",
      "type": "Form",
      "properties": {
        "action": { "name": "record_specimen" },
        "submitLabel": { "literalString": "Record Specimen" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "spec-title",
            "type": "Text",
            "properties": { "text": { "literalString": "Record Specimen" }, "usageHint": "h2" }
          },
          {
            "id": "spec-subtitle",
            "type": "Text",
            "properties": { "text": { "literalString": "Patient resolved from session." }, "usageHint": "caption" }
          },
          { "id": "spec-divider-top", "type": "Divider", "properties": {} },
          {
            "id": "spec-type-heading",
            "type": "Text",
            "properties": { "text": { "literalString": "Specimen Type" }, "usageHint": "h4" }
          },
          {
            "id": "type",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Specimen Type (SNOMED)" },
              "placeholder": { "literalString": "Search SNOMED…" },
              "valueType": { "literalString": "CodeableConcept" },
              "serverSearch": {
                "system": "http://snomed.info/sct",
                "minChars": 2,
                "debounceMs": 200
              }
            }
          },
          { "id": "spec-divider-status", "type": "Divider", "properties": {} },
          {
            "id": "spec-status-heading",
            "type": "Text",
            "properties": { "text": { "literalString": "Status & Accession" }, "usageHint": "h4" }
          },
          {
            "id": "spec-status-accession-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "status",
                  "type": "TerminologySelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Status" },
                    "placeholder": { "literalString": "Select status…" },
                    "items": "$status_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                },
                {
                  "id": "accession_identifier_value",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Accession ID" },
                    "placeholder": { "literalString": "e.g. ACC-2024-00123" },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          },
          { "id": "spec-divider-collection", "type": "Divider", "properties": {} },
          {
            "id": "spec-collection-heading",
            "type": "Text",
            "properties": { "text": { "literalString": "Collection" }, "usageHint": "h4" }
          },
          {
            "id": "spec-collector-datetime-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "collector",
                  "type": "DataSelect",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Collector (optional)" },
                    "placeholder": { "literalString": "Select practitioner…" },
                    "items": "$booking_practitioners.data",
                    "labelPath": "practitioner_detail.name.text",
                    "emits": [
                      { "key": "ref_id", "path": "practitioner_ref_id" }
                    ]
                  }
                },
                {
                  "id": "collected_datetime",
                  "type": "DateTimeInput",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Collected Date/Time (optional)" },
                    "enableDate": true,
                    "enableTime": true
                  }
                }
              ]
            }
          },
          {
            "id": "spec-qty-received-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "quantity_value",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Quantity" },
                    "placeholder": { "literalString": "e.g. 5" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "quantity_unit",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Unit (optional)" },
                    "placeholder": { "literalString": "mL" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "received_time",
                  "type": "DateTimeInput",
                  "weight": 2,
                  "properties": {
                    "label": { "literalString": "Received" },
                    "enableDate": true,
                    "enableTime": true
                  }
                }
              ]
            }
          },
          {
            "id": "body_site",
            "type": "TerminologySelect",
            "properties": {
              "label": { "literalString": "Body Site (optional)" },
              "placeholder": { "literalString": "Search SNOMED…" },
              "valueType": { "literalString": "CodeableConcept" },
              "serverSearch": {
                "system": "http://snomed.info/sct",
                "minChars": 2,
                "debounceMs": 200
              }
            }
          }
        ]
      }
    }
  }
}
