{
  "id": "patient-communication-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "patient-communication-form",
      "type": "Form",
      "properties": {
        "action": { "name": "add_patient_communication" },
        "submitLabel": { "literalString": "Save Languages" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Add Communication Languages" },
              "usageHint": "h2"
            }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Record the languages this patient can use to communicate with their care team. Select a language from the standard terminology and mark the patient's preferred language." },
              "usageHint": "caption"
            }
          },
          {
            "id": "divider-top",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "communications",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add Language" },
              "minItems": { "literalNumber": 1 },
              "defaultCount": { "literalNumber": 1 },
              "template": [
                {
                  "id": "language",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Language" },
                    "placeholder": { "literalString": "Search language…" },
                    "items": "$communication_language_concepts.concepts",
                    "valueType": { "literalString": "CodeableConcept" }
                  }
                },
                {
                  "id": "preferred",
                  "type": "CheckBox",
                  "properties": {
                    "label": { "literalString": "Preferred Language" },
                    "value": { "literalBoolean": false }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
