{
  "id": "patient-identifier-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "patient-identifier-form",
      "type": "Form",
      "properties": {
        "action": { "name": "add_patient_identifier" },
        "submitLabel": { "literalString": "Save Identifiers" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Add Patient Identifiers" },
              "usageHint": "h2"
            }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Attach one or more business identifiers such as MRN, SSN, insurance ID, or passport number." },
              "usageHint": "caption"
            }
          },
          {
            "id": "divider-top",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "identifiers",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add Identifier" },
              "minItems": { "literalNumber": 1 },
              "defaultCount": { "literalNumber": 1 },
              "template": [
                {
                  "id": "use",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Identifier Use" },
                    "placeholder": { "literalString": "Search use…" },
                    "items": "$identifier_use_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                },
                {
                  "id": "type",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Identifier Type" },
                    "placeholder": { "literalString": "Search type…" },
                    "items": "$identifier_type_concepts.concepts",
                    "valueType": { "literalString": "CodeableConcept" }
                  }
                },
                {
                  "id": "system",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Identifier System (URI)" },
                    "placeholder": { "literalString": "e.g. http://hospital.example.com/mrn" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "value",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Identifier Value" },
                    "placeholder": { "literalString": "e.g. MRN-123456" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "period-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "period_start",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Valid From (optional)" },
                          "enableDate": true,
                          "enableTime": false
                        }
                      },
                      {
                        "id": "period_end",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Valid To (optional)" },
                          "enableDate": true,
                          "enableTime": false
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
