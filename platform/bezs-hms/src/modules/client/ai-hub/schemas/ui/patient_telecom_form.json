{
  "id": "patient-telecom-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "patient-telecom-form",
      "type": "Form",
      "properties": {
        "action": { "name": "add_patient_telecom" },
        "submitLabel": { "literalString": "Save Contact Points" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Add Telecom Contact Points" },
              "usageHint": "h2"
            }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Record phone numbers, email addresses, fax, and other contact details. Set a priority rank (1 = highest preference) and optionally define a validity period." },
              "usageHint": "caption"
            }
          },
          {
            "id": "divider-top",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "telecom",
            "type": "RepeatableGroup",
            "properties": {
              "addLabel": { "literalString": "Add Contact Point" },
              "minItems": { "literalNumber": 1 },
              "defaultCount": { "literalNumber": 1 },
              "template": [
                {
                  "id": "system",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Contact Type" },
                    "placeholder": { "literalString": "Search contact type…" },
                    "items": "$telecom_system_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                },
                {
                  "id": "value",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Contact Value" },
                    "placeholder": { "literalString": "e.g. +1-555-123-4567 or user@example.com" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "use",
                  "type": "TerminologySelect",
                  "properties": {
                    "label": { "literalString": "Use (optional)" },
                    "placeholder": { "literalString": "Search use…" },
                    "items": "$telecom_use_concepts.concepts",
                    "valueType": { "literalString": "code" }
                  }
                },
                {
                  "id": "rank",
                  "type": "TextField",
                  "properties": {
                    "label": { "literalString": "Priority Rank (optional)" },
                    "placeholder": { "literalString": "e.g. 1 = highest preference" },
                    "textFieldType": "number"
                  }
                },
                {
                  "id": "period-row",
                  "type": "Row",
                  "properties": {
                    "gap": "medium",
                    "alignment": "stretch",
                    "children": [
                      {
                        "id": "period_start",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Valid From (optional)" },
                          "enableDate": true,
                          "enableTime": false
                        }
                      },
                      {
                        "id": "period_end",
                        "type": "DateTimeInput",
                        "weight": 1,
                        "properties": {
                          "label": { "literalString": "Valid To (optional)" },
                          "enableDate": true,
                          "enableTime": false
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
