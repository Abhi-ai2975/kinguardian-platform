{
  "id": "admin_create_practitioner",
  "name": "Admin: Create Practitioner",
  "description": "Admin-only workflow to register a new Practitioner for any platform user in 6 steps: target user selection, names, identifiers, telecom, qualifications, and communication languages. Unlike the standard workflow the target user ID is provided explicitly — not derived from the admin's own session.",
  "version": "1.0.0",
  "tags": ["fhir", "practitioner", "create", "crud", "healthcare", "admin"],
  "required_permissions": ["practitioner:create"],
  "llm_hints": {
    "intent_examples": [
      "Admin create practitioner",
      "Register a practitioner for another user",
      "Create a practitioner account for a specific user",
      "Admin register a new doctor",
      "Onboard a clinician for a user account"
    ],
    "when_to_use": [
      "Admin wants to create a Practitioner resource for a specific platform user",
      "The practitioner's user ID is known and must be provided explicitly",
      "Creating a practitioner that is NOT linked to the current session user"
    ],
    "when_not_to_use": [
      "User wants to register themselves as a practitioner (use create_practitioner)",
      "User wants to create a patient",
      "User wants to book an appointment"
    ],
    "required_context": []
  },
  "execution": {
    "mode": "deterministic",
    "orchestrator": "nextjs",
    "audit_enabled": true
  },
  "introduction": "I'll help you register a new practitioner for a specific user account in 6 steps — target user first, then names, identifiers, contact details, qualifications, and languages.",
  "completion": {
    "message": "Practitioner registered successfully.",
    "action": "dismiss"
  },
  "workflow_steps": [
    {
      "sequence_number": 1,
      "id": "admin_create_practitioner_resource",
      "name": "Create Practitioner",
      "step_type": "form",
      "description": "Provide the target user ID and core demographic details for the new practitioner.",
      "context": {
        "inputs": {},
        "outputs": {
          "practitioner_id": {
            "type": "integer",
            "resource": "Practitioner",
            "field": "id"
          }
        }
      },
      "context_resolvers": [
        {
          "description": "Fetch administrative-gender value set.",
          "context_key": "gender_concepts",
          "tool_name": "get_gender_valueset",
          "url": "$fhir_gql_url/terminology/concepts?resource=Patient&field=gender",
          "method": "GET",
          "timeout_ms": 8000
        }
      ],
      "ui": {
        "schema": "admin_practitioner_create_form",
        "mode": "create",
        "prefill": false,
        "editable": true
      },
      "actions": [
        {
          "type": "http",
          "purpose": "create_practitioner",
          "tool_name": "create_practitioner",
          "url": "$fhir_gql_url/practitioners/",
          "method": "POST",
          "validation_schema": "admin_practitioner_create_schema",
          "retryable": false,
          "timeout_ms": 10000
        }
      ]
    },
    {
      "sequence_number": 2,
      "id": "add_practitioner_names",
      "name": "Add Names",
      "step_type": "form",
      "optional": true,
      "description": "Add one or more names for this practitioner.",
      "context": {
        "inputs": {
          "practitioner_id": { "type": "integer", "source": "workflow" }
        },
        "outputs": {}
      },
      "context_resolvers": [
        {
          "description": "Confirm practitioner exists.",
          "tool_name": "get_practitioner_by_id",
          "url": "$fhir_gql_url/practitioners/$practitioner_id",
          "method": "GET",
          "timeout_ms": 10000
        },
        {
          "description": "Fetch name-use value set.",
          "context_key": "name_use_concepts",
          "tool_name": "get_name_use_valueset",
          "url": "$fhir_gql_url/terminology/concepts?resource=Patient&field=name.use",
          "method": "GET",
          "timeout_ms": 8000
        }
      ],
      "ui": {
        "schema": "practitioner_name_form",
        "mode": "append",
        "prefill": false,
        "editable": true
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_practitioner_name",
          "tool_name": "add_practitioner_name",
          "url": "$fhir_gql_url/practitioners/$practitioner_id/names",
          "method": "POST",
          "iterate_key": "names",
          "validation_schema": "practitioner_name_create_schema",
          "retryable": true,
          "timeout_ms": 10000
        }
      ]
    },
    {
      "sequence_number": 3,
      "id": "add_practitioner_identifiers",
      "name": "Add Identifiers",
      "step_type": "form",
      "optional": true,
      "description": "Add professional identifiers such as NPI, licence number, or DEA number.",
      "context": {
        "inputs": {
          "practitioner_id": { "type": "integer", "source": "workflow" }
        },
        "outputs": {}
      },
      "context_resolvers": [
        {
          "description": "Confirm practitioner exists.",
          "tool_name": "get_practitioner_by_id",
          "url": "$fhir_gql_url/practitioners/$practitioner_id",
          "method": "GET",
          "timeout_ms": 10000
        },
        {
          "description": "Fetch identifier-use value set.",
          "context_key": "identifier_use_concepts",
          "tool_name": "get_identifier_use_valueset",
          "url": "$fhir_gql_url/terminology/concepts?resource=Patient&field=identifier.use",
          "method": "GET",
          "timeout_ms": 8000
        },
        {
          "description": "Fetch identifier-type value set.",
          "context_key": "identifier_type_concepts",
          "tool_name": "get_identifier_type_valueset",
          "url": "$fhir_gql_url/terminology/concepts?resource=Patient&field=identifier.type",
          "method": "GET",
          "timeout_ms": 8000
        }
      ],
      "ui": {
        "schema": "practitioner_identifier_form",
        "mode": "append",
        "prefill": false,
        "editable": true
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_practitioner_identifier",
          "tool_name": "add_practitioner_identifier",
          "url": "$fhir_gql_url/practitioners/$practitioner_id/identifiers",
          "method": "POST",
          "iterate_key": "identifiers",
          "validation_schema": "practitioner_identifier_create_schema",
          "retryable": true,
          "timeout_ms": 10000
        }
      ]
    },
    {
      "sequence_number": 4,
      "id": "add_practitioner_telecom",
      "name": "Add Contact Points",
      "step_type": "form",
      "optional": true,
      "description": "Add phone, email, or other contact details for this practitioner.",
      "context": {
        "inputs": {
          "practitioner_id": { "type": "integer", "source": "workflow" }
        },
        "outputs": {}
      },
      "context_resolvers": [
        {
          "description": "Confirm practitioner exists.",
          "tool_name": "get_practitioner_by_id",
          "url": "$fhir_gql_url/practitioners/$practitioner_id",
          "method": "GET",
          "timeout_ms": 10000
        },
        {
          "description": "Fetch telecom-system value set.",
          "context_key": "telecom_system_concepts",
          "tool_name": "get_telecom_system_valueset",
          "url": "$fhir_gql_url/terminology/concepts?resource=Patient&field=telecom.system",
          "method": "GET",
          "timeout_ms": 8000
        },
        {
          "description": "Fetch telecom-use value set.",
          "context_key": "telecom_use_concepts",
          "tool_name": "get_telecom_use_valueset",
          "url": "$fhir_gql_url/terminology/concepts?resource=Patient&field=telecom.use",
          "method": "GET",
          "timeout_ms": 8000
        }
      ],
      "ui": {
        "schema": "practitioner_telecom_form",
        "mode": "append",
        "prefill": false,
        "editable": true
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_practitioner_telecom",
          "tool_name": "add_practitioner_telecom",
          "url": "$fhir_gql_url/practitioners/$practitioner_id/telecom",
          "method": "POST",
          "iterate_key": "telecom",
          "validation_schema": "practitioner_telecom_create_schema",
          "retryable": true,
          "timeout_ms": 10000
        }
      ]
    },
    {
      "sequence_number": 5,
      "id": "add_practitioner_qualifications",
      "name": "Add Qualifications",
      "step_type": "form",
      "optional": true,
      "description": "Add medical degrees, licences, and certifications.",
      "context": {
        "inputs": {
          "practitioner_id": { "type": "integer", "source": "workflow" }
        },
        "outputs": {}
      },
      "context_resolvers": [
        {
          "description": "Confirm practitioner exists.",
          "tool_name": "get_practitioner_by_id",
          "url": "$fhir_gql_url/practitioners/$practitioner_id",
          "method": "GET",
          "timeout_ms": 10000
        }
      ],
      "ui": {
        "schema": "practitioner_qualification_form",
        "mode": "append",
        "prefill": false,
        "editable": true
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_practitioner_qualification",
          "tool_name": "add_practitioner_qualification",
          "url": "$fhir_gql_url/practitioners/$practitioner_id/qualifications",
          "method": "POST",
          "iterate_key": "qualifications",
          "validation_schema": "practitioner_qualification_create_schema",
          "retryable": true,
          "timeout_ms": 10000
        }
      ]
    },
    {
      "sequence_number": 6,
      "id": "add_practitioner_communications",
      "name": "Add Communication Languages",
      "step_type": "form",
      "optional": true,
      "description": "Record languages this practitioner uses with patients.",
      "context": {
        "inputs": {
          "practitioner_id": { "type": "integer", "source": "workflow" }
        },
        "outputs": {}
      },
      "context_resolvers": [
        {
          "description": "Confirm practitioner exists.",
          "tool_name": "get_practitioner_by_id",
          "url": "$fhir_gql_url/practitioners/$practitioner_id",
          "method": "GET",
          "timeout_ms": 10000
        },
        {
          "description": "Fetch communication-language value set.",
          "context_key": "communication_language_concepts",
          "tool_name": "get_communication_language_valueset",
          "url": "$fhir_gql_url/terminology/concepts?resource=Patient&field=communication.language",
          "method": "GET",
          "timeout_ms": 8000
        }
      ],
      "ui": {
        "schema": "practitioner_communication_form",
        "mode": "append",
        "prefill": false,
        "editable": true
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_practitioner_communication",
          "tool_name": "add_practitioner_communication",
          "url": "$fhir_gql_url/practitioners/$practitioner_id/communications",
          "method": "POST",
          "iterate_key": "communications",
          "validation_schema": "practitioner_communication_create_schema",
          "retryable": true,
          "timeout_ms": 10000
        }
      ]
    }
  ]
}
