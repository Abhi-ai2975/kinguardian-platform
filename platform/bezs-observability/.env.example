# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=watcher
POSTGRES_USER=watcher
POSTGRES_PASSWORD=watcher_secret
POSTGRES_URL=postgresql://watcher:watcher_secret@localhost:5433/watcher

# watcher24 application database — feature tables owned by console, gateway,
# analytics-python and notifier-go (never the IAM database). See CLAUDE.md rule 9.
WATCHER24_DATABASE_URL=postgresql://watcher:watcher_secret@localhost:5433/watcher24

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=watcher
CLICKHOUSE_USER=watcher
CLICKHOUSE_PASSWORD=watcher_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO / S3
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=watcher
MINIO_SECRET_KEY=watcher_secret
MINIO_BUCKET=watcher-archive

# Gateway
GATEWAY_PORT=8080
GATEWAY_ENV=development

# IAM service (better-auth)
# API keys are issued by the IAM and validated here by the gateway
IAM_DATABASE_URL=postgresql://watcher:watcher_secret@localhost:5433/iam
BETTER_AUTH_SECRET=change_me_in_production

# Notifier service (Go) — delivers email + in-app notifications.
# See apps/notifier-go/docs/configuration.md for the full reference.
NOTIFIER_PORT=4004
NOTIFIER_ENV=development
# Shared secret for the X-Internal-Secret header — must match the value
# console and IAM use when calling the notifier's internal endpoints.
NOTIFIER_INTERNAL_SECRET=change-me

# SMTP — outbound email for the notifier's "email" channel.
# Phase 1 uses a Gmail app password (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASS=
SMTP_FROM_NAME=Watcher24

# Comma-separated list of active notification channels. Phase 1: email + in_app only.
# Add slack,webhook,pagerduty once those adapters are built.
CHANNELS_ENABLED=email,in_app
