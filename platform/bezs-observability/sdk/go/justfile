set dotenv-load := true

# List available recipes
default:
    @just --list

# Run all tests
test:
    go test ./...

# Run tests with verbose output
test-verbose:
    go test -v ./...

# Run tests with coverage report
test-cov:
    go test -coverprofile=coverage.out ./...
    go tool cover -func=coverage.out

# Build the SDK (confirms it compiles cleanly)
build:
    go build ./...

# Vet for suspicious constructs
lint:
    go vet ./...

# Tidy the module (remove unused dependencies)
tidy:
    go mod tidy

# Run the example app (requires .env with WATCHER_API_KEY)
example:
    cd ../../examples/go && go run .
