# Recommended .env for apps using watcher-sdk — copy to .env and fill in values.
# The SDK does NOT read these automatically; load them yourself (e.g. python-dotenv)
# and pass them into Client(...). See docs/configuration.md for the full example.

# Secret API key issued by IAM (Settings → API Keys) — keep this server-side only.
WATCHER_API_KEY=wtch_your_key_here

# Your application's name, as registered in the console (Settings → Apps).
WATCHER_APP_ID=my-service

# Deployment environment label attached to every event (e.g. production, staging).
WATCHER_ENVIRONMENT=production

# URL of the Watcher24 gateway that ingests events.
WATCHER_GATEWAY_URL=http://localhost:8080
