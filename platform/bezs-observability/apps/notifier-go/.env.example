# notifier-go environment variables
# Copy to ../../.env and fill in values

# Server
NOTIFIER_PORT=4004
NOTIFIER_ENV=development

# Internal secret — must match NOTIFIER_INTERNAL_SECRET used by console and IAM
NOTIFIER_INTERNAL_SECRET=change-me

# PostgreSQL — watcher24 application database (not the IAM database)
WATCHER24_DATABASE_URL=postgresql://watcher:watcher_secret@localhost:5433/watcher24

# Redis — same instance as gateway and analytics-python
REDIS_URL=redis://localhost:6379

# SMTP — Phase 1 uses Gmail app password. Swap to Resend later by changing these.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=gnvv2002@gmail.com
SMTP_PASS=change-me
SMTP_FROM_NAME=Watcher24

# Comma-separated list of active channels. Phase 1: email + in_app only.
# Add slack,webhook,pagerduty once those adapters are built.
CHANNELS_ENABLED=email,in_app
