# Redis
REDIS_URL=redis://localhost:6379

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=watcher
CLICKHOUSE_USER=watcher
CLICKHOUSE_PASSWORD=watcher_secret

# Worker behaviour
WORKER_BATCH_SIZE=100
WORKER_BLOCK_MS=2000

# Which workers to run (comma-separated)
WORKERS=audit,log,trace,metric,ai

# IAM service — retention scheduler fetches per-org retention windows from here
IAM_BASE_URL=http://localhost:3001
IAM_INTERNAL_SECRET=change-me-in-production

# How often the retention scheduler runs (seconds). Default: 86400 (24h)
RETENTION_INTERVAL_SECONDS=86400
