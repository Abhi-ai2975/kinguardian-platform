GATEWAY_PORT=8080
GATEWAY_ENV=development
# ISO alpha-2 fallback when GeoIP can't resolve the client IP (e.g. 127.0.0.1 in local dev).
# Set to your country code so the dashboard map shows data while developing locally.
# Leave empty in production — real traffic will always get GeoIP resolution.
GATEWAY_DEFAULT_COUNTRY=IN
IAM_DATABASE_URL=postgresql://watcher:watcher_secret@localhost:5433/iam
REDIS_URL=redis://localhost:6379

# ClickHouse — used to count monthly events per org for plan limit enforcement.
# Defaults already match the docker-compose service; override only for a custom setup.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=watcher
CLICKHOUSE_PASSWORD=watcher_secret
CLICKHOUSE_DB=watcher
