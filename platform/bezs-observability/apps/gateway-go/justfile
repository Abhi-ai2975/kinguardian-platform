set dotenv-load := true

# List available recipes
default:
    @just --list

# Run the gateway locally (requires docker-compose services up)
dev:
    go run ./main.go

# Build the binary
build:
    go build -o bin/gateway ./main.go

# Run all unit tests
test:
    go test ./...

# Run unit tests with verbose output
test-verbose:
    go test -v ./...

# Run tests with race detector
test-race:
    go test -race ./...

# Run integration tests (requires docker-compose up)
test-integration:
    go test ./tests/integration/...

# Check for vet errors and suspicious constructs
lint:
    go vet ./...

# Tidy go.mod and go.sum
tidy:
    go mod tidy

# Remove the built binary
clean:
    rm -rf bin/
