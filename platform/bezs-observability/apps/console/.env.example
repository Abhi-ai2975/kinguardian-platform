# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── IAM service (auth authority) ──────────────────────────────────────────────
# Server-to-server calls (bypasses the Next.js proxy).
IAM_URL=http://localhost:5000
# Browser-accessible IAM URL used for OAuth PKCE redirects.
NEXT_PUBLIC_IAM_URL=http://localhost:5000

# ── OAuth client credentials ──────────────────────────────────────────────────
# Register a client in the IAM admin panel (/admin/oauth-clients) to get these.
# NEXT_PUBLIC_ prefix is intentional — the client_id is public (safe to expose).
NEXT_PUBLIC_CONSOLE_CLIENT_ID=
# The client_secret is server-side only. Never expose this to the browser.
CONSOLE_CLIENT_SECRET=

# ── ClickHouse (telemetry data store) ─────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=watcher
CLICKHOUSE_PASSWORD=watcher_secret
CLICKHOUSE_DB=watcher

# ── IAM internal API secret ───────────────────────────────────────────────────
# Shared secret for server-to-server calls to IAM's /api/internal/* endpoints.
# Must match INTERNAL_API_SECRET in apps/iam/.env.
INTERNAL_API_SECRET=

# ── Gateway (telemetry ingestion) ─────────────────────────────────────────────
# Server-to-server URL used by the /api/ingest proxy route.
GATEWAY_URL=http://localhost:8080

# ── Realtime service (WebSocket endpoint) ─────────────────────────────────────
# Used by the browser-side live feed; must be reachable from the client.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8081

# ── Notifier service ───────────────────────────────────────────────────────────
# Server-to-server URL used by the /api/notifications/* proxy routes.
NOTIFIER_URL=http://localhost:4004
# Must match NOTIFIER_INTERNAL_SECRET in the root .env used by apps/notifier-go.
NOTIFIER_INTERNAL_SECRET=change-me

# ── Admin database (direct Postgres access) ────────────────────────────────────
# Used only by the superadmin overview/org pages (src/lib/admin-db.ts) to read
# organization/member/subscription data. Points at the same Postgres instance
# as IAM_DATABASE_URL in apps/iam/.env, port 5433.
DATABASE_URL=postgresql://watcher:watcher_secret@localhost:5433/iam
