# realtime-go environment variables — copy to .env and fill in values

# HTTP/WebSocket port this service listens on.
PORT=8081

# Redis — subscribes to the same pub/sub channels gateway-go publishes to,
# fans events out to connected WebSocket clients.
REDIS_URL=redis://localhost:6379

# IAM database — used to resolve which org/app a WebSocket connection belongs
# to so events are only fanned out to clients authorized for that org.
IAM_DATABASE_URL=postgresql://watcher:watcher_secret@localhost:5433/iam

# Deployment region label, reserved for multi-region fan-out. Leave empty in local dev.
REGION=
