set dotenv-load := true

# List available recipes
default:
    @just --list

# Run the realtime service locally (requires docker-compose services up)
dev:
    go run ./main.go

# Build the binary
build:
    go build -o bin/realtime ./main.go

# Run all unit tests
test:
    go test ./...

# Run tests with verbose output
test-verbose:
    go test -v ./...

# Run tests with race detector
test-race:
    go test -race ./...

# Check for vet errors
lint:
    go vet ./...

# Tidy go.mod and go.sum
tidy:
    go mod tidy

# Remove built binary
clean:
    rm -rf bin/
