# ── Browser / React client (public token — safe to expose) ──────────────────
# Create a public token in the console (Settings → API Keys → Public Tokens tab).
# Link it to the same app as your server key so browser and server events are
# grouped together in the dashboard under the same application.
# The gateway enforces origin allowlist + per-minute rate limit on public tokens.
VITE_W24_PUBLIC_TOKEN=wpub_your_public_token_here
VITE_W24_GATEWAY_URL=http://localhost:8080

# ── Server / Express backend (server-side key — keep secret) ────────────────
# Create an app in the console (Settings → Apps), link a server-side key to it.
# The gateway resolves the app automatically from the key — no appId needed.
W24_API_KEY=wt_your_server_key_here
W24_GATEWAY_URL=http://localhost:8080

# Optional — only needed for legacy org-level keys that have no app linked.
# W24_APP_ID=task-tracker-server

PORT=3001

# Base URL of the Express server — used by the SDK Test Lab page in the React client.
VITE_W24_SERVER_URL=http://localhost:3001
