# Watcher24 React Native example
# Copy to .env and fill in your values from the Watcher24 console.

# Public token from Settings → API Keys → Public Tokens
# NEVER use a secret key (wtch_) in a mobile app — use wpub_ only.
EXPO_PUBLIC_W24_PUBLIC_TOKEN=wpub_your_public_token_here

# App ID from Settings → Apps (optional)
EXPO_PUBLIC_W24_APP_ID=your_app_id_here
