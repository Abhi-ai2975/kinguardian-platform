# Watcher24 Go example — copy to .env and fill in your values

# Secret API key from the Watcher24 console (Settings → API Keys)
WATCHER_API_KEY=wtch_your_secret_key_here

# Application ID from the Watcher24 console (optional but recommended)
WATCHER_APP_ID=your_app_id_here

# Deployment environment label
APP_ENV=development
