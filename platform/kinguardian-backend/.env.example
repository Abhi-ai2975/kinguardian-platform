# DrGodly / KinGuardian Platform Configuration (.env.example)
# Copy this file to .env and replace default values with environment-specific configuration.
# WARNING: NEVER commit .env with production credentials to source control.

# ── Environment & Logging ────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# ── Core Database & Cache ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://iam_user:iam_password@postgres:5432/kinguardian_db
REDIS_URL=redis://redis:6379/0

# ── Identity & Access Management (IAM) ───────────────────────────────────────
IAM_ISSUER=http://localhost:5001
IAM_JWKS_URL=http://localhost:5001/api/auth/jwks
IAM_AUDIENCE=kinguardian-platform-api
JWT_SECRET_KEY=dev-secret-key-32-bytes-minimum-length!
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=dev-phi-aes-256-gcm-master-encryption-key

# ── Clinical & FHIR Core Services ────────────────────────────────────────────
FHIR_API_URL=http://localhost:8006/api/v1
FHIR_GQL_URL=http://localhost:8005/api/v1

# ── Document Storage & Compliance (FileNest WORM) ────────────────────────────
FILENEST_URL=http://localhost:8000
FILENEST_API_KEY=dev_filenest_secret_key
FILENEST_PROJECT_ID=dev_project_kinguardian

# ── AI Agent Service & LLM Gateway ───────────────────────────────────────────
AGENT_SERVICE_URL=http://localhost:8000
AGENT_TIMEOUT=15.0

# ── Observability & Distributed Telemetry ────────────────────────────────────
OBSERVABILITY_URL=http://localhost:4318

# ── Notification Provider ────────────────────────────────────────────────────
NOTIFICATION_PROVIDER=in_app

# ── NATS Event Streaming Bus ─────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=KINGUARDIAN_EVENTS
EVENT_BUS_TYPE=in_memory

