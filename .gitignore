# =========================================================================
# KinGuardian Platform - Root .gitignore
# Prevents publishing secrets, credentials, logs, caches, and build outputs
# =========================================================================

# --- Secrets, Environment Variables & Credentials ---
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
!debug.keystore
*.jks
id_rsa
id_ed25519
*.token

# --- Logs & Diagnostics ---
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
uvicorn*.log

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Databases & SQLite Stores ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
kinguardian.db

# --- Node.js & React Native / Expo ---
node_modules/
.expo/
.metro-health-check*
*.tsbuildinfo

# --- Android Build & Caches ---
android/.gradle/
android/app/build/
android/build/
*.apk
*.aab

# --- iOS Build & Caches ---
ios/build/
ios/Pods/
*.ipa

# --- IDEs & OS Files ---
.idea/
.vscode/
.agents/
.DS_Store
Thumbs.db
desktop.ini

# --- Backups & Temporary Files ---
*.bak
*.backup
*.tmp
*.swp
*~
