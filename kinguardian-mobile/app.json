{
  "expo": {
    "name": "KinGuardian",
    "slug": "kinguardian-prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "kinguardian",

    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kinguardian.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2a14b4"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
