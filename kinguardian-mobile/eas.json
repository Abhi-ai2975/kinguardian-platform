{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.107.196.132:8000",
        "EXPO_PUBLIC_ENVIRONMENT": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.107.196.132:8000",
        "EXPO_PUBLIC_ENVIRONMENT": "development"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
